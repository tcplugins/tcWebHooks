<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
               http://www.springframework.org/schema/beans
               http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
       default-autowire="constructor">

    <bean id="securityContext" class="webhook.teamcity.test.springmock.MockSecurityContext"/>
    <bean id="permissionChecker" class="org.mockito.Mockito" factory-method="mock">
        <constructor-arg value="jetbrains.buildServer.server.rest.data.PermissionChecker"/>
    </bean>

    <bean id="requestPathTransformInfo" class="jetbrains.buildServer.server.rest.RequestPathTransformInfo"/>
    <bean id="beanFactory" class="jetbrains.buildServer.server.rest.util.BeanFactory"/>
    <bean id="sBuildServer" class="webhook.teamcity.test.springmock.MockSBuildServer"/>
    <bean id="projectManager" class="webhook.teamcity.test.springmock.MockProjectManager"/>
    <bean id="projectSettingsManager" class="webhook.teamcity.test.springmock.MockProjectSettingsManager"/>
    <bean id="configActionFactory" class="webhook.teamcity.test.springmock.MockConfigActionFactory"/>
<!--     <bean id="eventDispatcher" class="webhook.teamcity.test.springmock.MockEventDispatcher"/>
 -->
    <bean id="restControllerExtensionInitializer" class="webhook.teamcity.server.rest.RESTControllerExtensionInitializer"/>

    <bean id="mainConfigManager" class="webhook.teamcity.server.rest.util.mainconfig.MainConfigManager"/>
    <bean id="dataProvider" class="webhook.teamcity.server.rest.data.DataProvider"/>
    <bean id="templateFinder" class="webhook.teamcity.server.rest.data.TemplateFinder"/>
    <bean id="webHookManager" class="webhook.teamcity.server.rest.data.WebHookManager"/>
    <bean id="webHookParameterFinder" class="webhook.teamcity.server.rest.data.WebHookParameterFinder"/>
    <bean id="webHookSettingsManagerProvider" class="webhook.teamcity.server.rest.jersey.WebHookSettingsManagerProvider"/>
<!--     <bean id="projectsModelListener" class="webhook.teamcity.test.springmock.MockProjectsModelListener"/>
 -->
    <bean id="webHookUserRequestedExecutor" class="org.mockito.Mockito" factory-method="mock">
        <constructor-arg value="webhook.teamcity.testing.WebHookUserRequestedExecutor"/>
    </bean>
    <bean id="buildTypeIdResolver" class="webhook.teamcity.test.springmock.MockBuildTypeIdResolver"/>

    <bean id="webHookContentBuilder" class="webhook.teamcity.WebHookContentBuilder"/>
    <bean id="webHookFactory" class="webhook.teamcity.WebHookFactoryImpl"/>
    <bean id="webHookProjectSettings" class="webhook.teamcity.settings.WebHookProjectSettings"/>
    <bean id="webHookFeaturesStore" class="webhook.teamcity.settings.WebHookProjectFeaturesStore"/>
    <bean id="webHookSettingsManager" class="webhook.teamcity.settings.WebHookSettingsManagerImpl"/>
    <bean id="webAddressTransformer" class="webhook.teamcity.history.WebAddressTransformerImpl"/>
    <bean id="webHookProjectSettingsFactory" class="webhook.teamcity.settings.WebHookProjectSettingsFactory"/>
    <bean id="projectFeatureToWebHookConfigConverter" class="webhook.teamcity.settings.ProjectFeatureToWebHookConfigConverter"/>

    <bean id="webHookMainSettings" class="webhook.teamcity.settings.WebHookMainSettings" init-method="register"/>

    <bean id="webHookPayloadManager" class="webhook.teamcity.payload.WebHookPayloadManager"/>
    <bean id="webHookAuthenticatorProvider" class="webhook.teamcity.auth.WebHookAuthenticatorProvider"/>
    <bean id="webHookTemplateManager" class="webhook.teamcity.payload.WebHookTemplateManager"/>
    <bean id="webHookTemplateResolver" class="webhook.teamcity.payload.WebHookTemplateResolver"/>

    <bean id="webHookParameterStoreFactory" class="webhook.teamcity.settings.project.WebHookParameterStoreFactoryImpl"/>
    <bean id="teamCityCoreFacade" class="webhook.teamcity.TeamCityCoreFacadeImpl"/>
    <bean id="webHookTemplateJaxHelper" class="webhook.teamcity.settings.entity.WebHookTemplateJaxTestHelper"/>
    <bean id="webHookHttpClientFactory" class="webhook.teamcity.WebHookHttpClientFactoryImpl"/>

    <bean id="webHookVariableResolverManager" class="webhook.teamcity.payload.variableresolver.WebHookVariableResolverManagerImpl"/>
    <bean id="projectIdResolver" class="webhook.teamcity.test.jerseyprovider.ProjectIdResolverMock"/>

</beans>
