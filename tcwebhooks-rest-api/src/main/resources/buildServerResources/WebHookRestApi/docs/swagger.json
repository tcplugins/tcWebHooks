          "text": "Using WebHooks in myCompany Inc.",
          "url": "http://intranet.mycompany.com/docs/UsingWebHooks",
          "further-reading": true
        }
      }
    },
    "TemplateSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "template.id:slackcompact"
        },
        "name": {
          "type": "string",
          "example": "Slack (Compact)"
        },
        "description": {
