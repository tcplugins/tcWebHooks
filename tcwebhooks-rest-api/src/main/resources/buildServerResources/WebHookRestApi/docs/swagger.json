        "count": 2,
        "templates": [
          {
            "id": "template.id:slackcompact",
            "name": "Slack (Compact)",
            "description": "Compact Slack notification",
            "href": "/app/rest/webhooks/templates/template.id:slackcompact"
          },
          {
            "id": "template.id:flowdock",
            "name": "Flowdock",
            "description": "Flowdock room messages",
            "href": "/app/rest/webhooks/templates/template.id:flowdock"
          }
        ]
      }
    },
    "TemplateExecutionRequest": {
      "type": "object",
      "required": ["templateId", "projectId", "buildState"],
      "properties": {
        "templateId": {
          "type": "string",
          "example": "template.id:slackcompact"
        },
        "projectId": {
          "type": "string",
          "example": "_Root"
        },
        "buildState": {
          "type": "string",
          "example": "buildFinished"
        },
        "branchName": {
          "type": "string",
          "example": "refs/heads/main"
        },
        "payloadFormat": {
          "type": "string",
          "example": "json"
        }
      },
      "example": {
        "templateId": "template.id:slackcompact",
        "projectId": "_Root",
        "buildState": "buildFinished",
        "branchName": "refs/heads/main",
        "payloadFormat": "json"
      }
    },
    "TemplateExecutionResult": {
      "type": "object",
